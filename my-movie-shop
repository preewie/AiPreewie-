<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ហាងលក់រឿង - Mini App</title>
    <!-- Telegram Web App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-color: #0088cc;
            --text-color: #ffffff;
            --text-sub: #94a3b8;
            --btn-buy: #2563eb;
            --btn-cancel: #ef4444;
        }

        body {
            font-family: 'Kantumruy Pro', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 12px;
        }

        /* Header Layout */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 15px;
            border-bottom: 1px solid #334155;
            margin-bottom: 15px;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: bold;
        }
        .credit-badge {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        /* Product Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #334155;
            display: flex;
            flex-direction: column;
        }
        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .card-content {
            padding: 10px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .title {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 8px;
            line-height: 1.3;
        }
        .price {
            color: #38bdf8;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        .btn-buy {
            background-color: var(--btn-buy);
            color: white;
            border: none;
            padding: 8px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: auto;
        }

        /* Payment Modal Popup */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            align-items: center;
            justify-content: center;
            padding: 15px;
            z-index: 1000;
        }
        .modal.active { display: flex; }
        .modal-content {
            background: var(--card-bg);
            border-radius: 16px;
            width: 100%;
            max-width: 360px;
            padding: 20px;
            text-align: center;
            border: 1px solid #475569;
        }
        .qr-code {
            width: 200px;
            height: 200px;
            background: #fff;
            margin: 15px auto;
            padding: 10px;
            border-radius: 12px;
        }
        .qr-code img { width: 100%; height: 100%; }
        .upload-section {
            margin-top: 15px;
            text-align: left;
            font-size: 13px;
        }
